# ─── Database (Neon Postgres) ───
# DB_URL is what the app reads; DATABASE_URL is accepted as a fallback.
DB_URL="postgres://user:password@host/campusloop?sslmode=require"
DATABASE_URL=""

# ─── Hexclave Auth ───
NEXT_PUBLIC_HEXCLAVE_API_URL="https://api.hexclave.com"
NEXT_PUBLIC_HEXCLAVE_PROJECT_ID=""
HEXCLAVE_SECRET_SERVER_KEY=""

# ─── Anonymous identity vault ───
# ANON_PEPPER: HMAC key for pseudonym handles. Generate: openssl rand -hex 32
# ANON_VAULT_SECRET: AES-256 key sealing real identities. Generate: openssl rand -hex 32
# Both must NEVER rotate casually — handles are derived from the pepper and
# sealed identities become undecryptable if the vault secret is lost.
ANON_PEPPER=""
ANON_VAULT_SECRET=""

# ─── Admin console auth ───
# ADMIN_PASSKEY: owner passkey for /admin-login (constant-time compared).
# ADMIN_SESSION_SECRET: HMAC key signing the admin session cookie.
# Both are REQUIRED in production — the app throws on boot without them.
# Generate: openssl rand -hex 32
ADMIN_PASSKEY=""
ADMIN_SESSION_SECRET=""

# ─── Web Push (VAPID) ───
# Generate a keypair with: bun run scripts/generate-vapid-keys.ts
# Push stays dormant and the opt-in UI stays hidden until these are set.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is inlined at build time, so it must be present
# in the build environment, not just at runtime.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hello@campusloop.space"

# ─── Media & integrations ───
IMGBB_API_KEY=""
NEXT_PUBLIC_IMGBB_API_KEY=""
GIPHY_API_KEY=""
NEXT_PUBLIC_GIPHY_API_KEY=""
