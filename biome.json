{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "src/**",
      "!**/.next/**",
      "!**/node_modules/**",
      "!**/out/**",
      "!**/.open-next/**",
      "!**/drizzle/**",
      "!**/dist/**",
      "!**/public/**",
      "!**/scripts/**",
      "!src/components/animate-ui/**"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off",
        "useImportType": "off"
      },
      "complexity": {
        "useOptionalChain": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noArrayIndexKey": "off",
        "noGlobalIsNan": "off",
        "noAssignInExpressions": "off",
        "useIterableCallbackReturn": "off",
        "noDocumentCookie": "off"
      },
      "a11y": {
        "useKeyWithClickEvents": "off",
        "useAltText": "off",
        "useButtonType": "off",
        "noLabelWithoutControl": "off",
        "noAutofocus": "off",
        "noStaticElementInteractions": "off",
        "noSvgWithoutTitle": "off",
        "noRedundantAlt": "off",
        "useIframeTitle": "off",
        "useAriaPropsSupportedByRole": "off"
      },
      "performance": {
        "noImgElement": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off"
      },
      "correctness": {
        "useExhaustiveDependencies": "off",
        "noUnusedVariables": "off",
        "noUnusedFunctionParameters": "off",
        "useHookAtTopLevel": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "es5"
    }
  }
}
