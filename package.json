{
	"name": "campusloop",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "NODE_OPTIONS='--max-old-space-size=5120' next build --webpack",
		"start": "next start",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"db:seed": "bun run scripts/seed-colleges.ts",
		"db:backfill-anon": "bun run scripts/backfill-anon-vault.ts",
		"db:migrate-follows": "bun run scripts/migrate-follows.ts",
		"db:seed-follows": "bun run scripts/seed-follows.ts",
		"deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
		"check": "biome check --write ./src",
		"format": "biome format --write ./src"
	},
	"dependencies": {
		"@base-ui/react": "^1.6.0",
		"@hexclave/next": "^1.0.36",
		"@neondatabase/serverless": "^1.1.0",
		"@opennextjs/cloudflare": "^1.19.9",
		"@tiptap/react": "^3.27.1",
		"@tiptap/starter-kit": "^3.27.1",
		"@types/canvas-confetti": "^1.9.0",
		"@types/prismjs": "^1.26.6",
		"@upstash/redis": "^1.38.3",
		"canvas-confetti": "^1.9.4",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.4.0",
		"drizzle-orm": "^0.45.2",
		"lucide-react": "^1.22.0",
		"motion": "^12.42.2",
		"next": "16.2.6",
		"next-themes": "^0.4.6",
		"peerjs": "^1.5.5",
		"prismjs": "^1.30.0",
		"qrcode": "^1.5.4",
		"radix-ui": "^1.4.3",
		"react": "^19.1.7",
		"react-day-picker": "^10.0.1",
		"react-dom": "^19.1.7",
		"recharts": "3.8.0",
		"sonner": "^2.0.7",
		"swr": "^2.4.2",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"vaul": "^1.1.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@next/eslint-plugin-next": "16.2.6",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^26.4.0",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19.1.7",
		"@types/react-dom": "^19.1.7",
		"@typescript-eslint/eslint-plugin": "^8.60.1",
		"@typescript-eslint/parser": "^8.60.1",
		"csv-parse": "^6.2.1",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"eslint": "^9",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"tailwindcss": "^4",
		"typescript": "^5.7.4",
		"vitest": "^4.1.11",
		"wrangler": "^4.97.0"
	}
}
